# ==========================================
# Application Configuration & AI Template
# ==========================================

# Port Server
PORT=3000

# Base Path (kosongkan jika berjalan di root "/")
NEXT_PUBLIC_BASE_PATH=

# Endpoint API Baru (untuk integrasi data selanjutnya)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Google Gemini AI Key (digunakan untuk template modul AI & analisis laporan)
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
